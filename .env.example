# Supabase — ana nejdettut.com projesinin env'inden kopyala
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq — AI puanlama + ders özeti
GROQ_API_KEY=

# Legacy eğitmen auth (geri uyum için saklandı; yeni akış Google OAuth + whitelist).
# İkisi de aktif: ya cookie-session ya da x-instructor-secret header.
LMS_INSTRUCTOR_SECRET=

# Çoklu eğitmen whitelist — virgülle ayır. nejdettut@gmail.com default olarak kabul edilir.
# Örn: LMS_INSTRUCTOR_EMAILS=ogretmen1@okul.edu.tr,ogretmen2@okul.edu.tr
LMS_INSTRUCTOR_EMAILS=
